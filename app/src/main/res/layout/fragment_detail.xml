<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:fillViewport="true" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:padding="18dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/title" android:text="Fiche contact" android:textSize="24sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <ImageView android:id="@+id/photo" android:contentDescription="Photo du contact" android:src="@android:drawable/ic_menu_myplaces" android:scaleType="centerCrop" android:layout_width="88dp" android:layout_height="88dp" />
        <EditText android:id="@+id/first" android:hint="Prénom *" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/last" android:hint="Nom *" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/phone" android:hint="Téléphone *" android:inputType="phone" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/email" android:hint="E-mail" android:inputType="textEmailAddress" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/latitude" android:hint="Latitude (facultatif)" android:inputType="numberDecimal|numberSigned" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/longitude" android:hint="Longitude (facultatif)" android:inputType="numberDecimal|numberSigned" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/edit" android:text="Modifier" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/save" android:text="Enregistrer" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/cancel" android:text="Annuler" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <Button android:id="@+id/delete" android:text="Supprimer" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/call" android:text="Appeler" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/mail" android:text="Envoyer un e-mail" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/gallery" android:text="Choisir une photo" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/camera" android:text="Prendre une photo" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/map" android:text="Voir sur la carte" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
